{
  "compilerOptions": {
    "target": "ES2022",
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["*.ts", "agent/**/*.ts", "scripts/**/*.ts", "services/**/*.ts", ".eve/**/*.d.ts"]
}
