{
  "name": "@workflow/world-postgres",
  "version": "5.0.0-beta.35",
  "description": "A reference World implementation based on PostgreSQL",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bootstrap": "./bin/setup.js",
    "workflow-postgres-setup": "./bin/setup-deprecated.js"
  },
  "files": [
    "dist",
    "bin",
    "src/drizzle/migrations"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/workflow.git",
    "directory": "packages/world-postgres"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/drizzle/schema.d.ts",
      "default": "./dist/drizzle/schema.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./migrations/*.sql": "./src/drizzle/migrations/*.sql"
  },
  "dependencies": {
    "@vercel/queue": "0.5.0",
    "cbor-x": "1.6.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "graphile-worker": "0.16.6",
    "pg": "8.20.0",
    "ulid": "~3.0.1",
    "zod": "~4.3.6",
    "@workflow/errors": "5.0.0-beta.17",
    "@workflow/utils": "5.0.0-beta.8",
    "@workflow/world": "5.0.0-beta.28",
    "@workflow/world-local": "5.0.0-beta.37"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.12.0",
    "@types/node": "22.19.0",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "@workflow/errors": "5.0.0-beta.17",
    "@workflow/tsconfig": "5.0.0-beta.0",
    "@workflow/world-testing": "5.0.0-beta.43"
  },
  "keywords": [],
  "author": "",
  "scripts": {
    "build": "tsc && chmod +x bin/setup.js bin/setup-deprecated.js",
    "dev": "tsc --watch",
    "clean": "tsc --build --clean && rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "node dist/cli.js"
  }
}