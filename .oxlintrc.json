{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unbound-method": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "stress/**",
        "evals/**"
      ],
      "rules": {
        "typescript/no-base-to-string": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".eve/**",
    ".output/**",
    ".runtime/**",
    ".tmp/**",
    "node_modules/**",
    "stress/**/node_modules/**",
    "services/skill-lab/.eve/**"
  ]
}
